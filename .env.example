# Copy to .env for local overrides. Placeholders only - never commit real secrets.
POSTGRES_DB=websec_dev
POSTGRES_USER=websec_dev
POSTGRES_PASSWORD=change_me_local_only
# Used by api/worker containers (host "postgres"). For `dotnet run` on the host, appsettings.Development.json uses localhost.
DATABASE_URL=Host=postgres;Port=5432;Database=websec_dev;Username=websec_dev;Password=change_me_local_only
JWT_ISSUER=WebSecPlatform
JWT_AUDIENCE=WebSecPlatformClient
# >= 32 chars. If left as the placeholder in Development, the API generates an ephemeral key.
JWT_SIGNING_KEY=replace_with_a_long_random_development_key
FRONTEND_ORIGIN=http://localhost:4200
AI_PROVIDER=mock
AI_API_KEY=
# Development-only opt-in for loopback/private lab targets (ignored outside Development).
ALLOW_PRIVATE_TARGETS=true
